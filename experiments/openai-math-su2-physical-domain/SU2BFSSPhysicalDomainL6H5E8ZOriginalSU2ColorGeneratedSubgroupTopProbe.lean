import SU2BFSSPhysicalDomainL6H5E8YOriginalSU2ExactSourceEulerFactorizationProbe

/-!
L6H5E8Z: ORIGINAL SU2 COLOR SOURCE-GENERATED SUBGROUP = TOP.

Qualified prerequisites:
H5E8M #330: the genuine source positive-i color-curve set and
its algebraic generated subgroup as Subgroup.closure, plus exact
membership for source curves.
H5E8U #350: three-curve original Z(a) Y(b) Z(c) product belongs
to that original generated subgroup.
H5E8Y #356: every g in the ORIGINAL GaugeGroup 2 is exactly
some product Z(a) Y(b) Z(c), with explicit zero-safe real times.

This is stronger than dense generation: algebraic (finite word)
generation, for the original source positive-i color curves.
No analytic density, Lie-algebra spanning assumption, extra axiom,
Fock replacement, physical-kernel theorem, or spectral conclusion.
-/

set_option autoImplicit false
set_option maxHeartbeats 450000
set_option synthInstance.maxHeartbeats 170000

namespace FCP.BFSSSU2PhysicalDomainL6H5E8Z
noncomputable section

open OAI.BFSSQuantum
open FCP.BFSSSU2PhysicalDomainL6H5E8M
open FCP.BFSSSU2PhysicalDomainL6H5E8U
open FCP.BFSSSU2PhysicalDomainL6H5E8Y

/-- Every member of the ORIGINAL SU2 gauge group lies in the
algebraically generated subgroup of the exact original positive-i
Pauli color curves, with no limiting or closure argument beyond
the ordinary subgroup generated by its actual elements. -/
theorem originalSU2_mem_source_color_generated (g : GaugeGroup 2) :
    g ∈ actualOriginalColorGeneratedSubgroup := by
  obtain ⟨a, b, c, hfactor⟩ := original_source_zyz_exists g
  rw [← hfactor]
  exact original_source_zyz_mem_generated a b c

/-- The original positive-i color gauge transformations generate
the ENTIRE genuine SU2 gauge group algebraically, not just a dense
subgroup or an auxiliary SU2 copy. -/
theorem original_source_color_generated_eq_top :
    actualOriginalColorGeneratedSubgroup = ⊤ := by
  ext g
  constructor
  · intro _
    simp
  · intro _
    exact originalSU2_mem_source_color_generated g

#print axioms originalSU2_mem_source_color_generated
#print axioms original_source_color_generated_eq_top
#check @original_source_color_generated_eq_top

end
end FCP.BFSSSU2PhysicalDomainL6H5E8Z

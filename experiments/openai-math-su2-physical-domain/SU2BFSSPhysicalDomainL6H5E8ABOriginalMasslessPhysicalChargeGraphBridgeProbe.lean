/-!
L6H5E8AB — SOURCE-REALIZATION BRIDGE, PROSPECTIVE until strict CI.

This module does NOT re-prove source supercharges. It identifies
the original source-defined closed charge graphs at h=1,m=0,
using G4K9D's already qualified exact SmoothCore charge equality,
and relates the ACTUAL pairedGaugeData invariant SmoothCore to
the newly qualified H5E8AA maximal source Gauss generator kernels.

Original source (pinned OAI/MathematicalPhysics/BFSS):
- Core.lean: charge, chargeVector, fullCoreGraph, fullClosedGraph;
- ClosedProfiles.lean: deformedChargeVector, deformedCoreGraph,
  deformedClosedGraph, GaugeData.deformedModelGraph(Map);
- GaugeCore.lean: GaugeData.invariantCore defined by preimage of
  the exact physicalSpace under coreToL2.

The two graph closure identities are for the ORIGINAL source
Hilbert types, not for the separate 2026 preprint's Hamiltonian.
Neither closed-form associated-operator equality, global Spin(9)
covariance, nor a spectral theorem is assumed or claimed.
-/

set_option autoImplicit false
set_option maxHeartbeats 450000
set_option synthInstance.maxHeartbeats 170000

namespace FCP.BFSSSU2PhysicalDomainL6H5E8AB
noncomputable section

open OAI.BFSSQuantum
open OAI.BFSSQuantum.AlgebraData
open FCP.BFSSSU2GaugeG1A
open FCP.BFSSSU2GaugeG4J
open FCP.BFSSSU2GaugeG4K9D
open FCP.BFSSSU2PhysicalDomainL6H5E8E
open FCP.BFSSSU2PhysicalDomainL6H5E8AA

/-- The original sixteen-charge column is EXACTLY the
massless h=1,m=0 source-deformed column on the entire
original unrestricted smooth core, not just on vectors
assumed to satisfy the Gauss constraints. -/
theorem original_source_chargeVector_eq_massless
    {N : ℕ} (M : AlgebraData N) :
    M.deformedChargeVector 1 0 = M.chargeVector := by
  ext f α
  change coreToL2 (M.deformedCoreCharge 1 0 α f) =
    coreToL2 (M.charge α f)
  rw [sourceUnconditionalCoreCharge_equal M α f]

/-- The actual source unrestricted graph at h=1,m=0
is exactly the source graph generated by original
sixteen supercharges, with no graph-domain enlargement. -/
theorem original_source_coreGraph_eq_massless
    {N : ℕ} (M : AlgebraData N) :
    M.deformedCoreGraph 1 0 = M.fullCoreGraph := by
  unfold AlgebraData.deformedCoreGraph AlgebraData.fullCoreGraph
  rw [original_source_chargeVector_eq_massless M]

/-- Equality survives closure in the ACTUAL source
product Hilbert space; it is not a statement about
an arbitrary maximal differential operator domain. -/
theorem original_source_closedGraph_eq_massless
    {N : ℕ} (M : AlgebraData N) :
    M.deformedClosedGraph 1 0 = M.fullClosedGraph := by
  unfold AlgebraData.deformedClosedGraph AlgebraData.fullClosedGraph
  rw [original_source_coreGraph_eq_massless M]

/-- The actual original invariant smooth core has the
precise SOURCE maximal Gauss kernel membership condition
for its FullL2 representative, without any density
assumption or replacement of source SmoothCore. -/
theorem original_source_smoothCore_invariant_iff_gauss
    (f : SmoothCore 2) :
    (f ∈ pairedGaugeData.invariantCore) ↔
      ∀ c : ColorIndex 2,
        ∃ hdom : coreToL2 f ∈
          actualOriginalColorGeneratorDomainSubmodule c,
          actualOriginalColorGeneratorLinear c
            ⟨coreToL2 f, hdom⟩ = 0 := by
  change coreToL2 f ∈ pairedGaugeData.physicalSpace ↔ _
  exact (actualOriginalJointKernel_iff_physical (coreToL2 f)).symm

/-- Original physical-core sixteen-charge graph, WITHOUT
deformation or model replacement. Its domain is the exact
original GaugeData.invariantCore and its output uses
the original source chargeVector. -/
def original_source_physicalCoreGraph
    {N : ℕ} (M : AlgebraData N) (G : M.GaugeData) :
    Submodule ℂ (FullL2 N × (SpinIndex → FullL2 N)) :=
  LinearMap.range
    ((coreToL2.comp G.invariantCore.subtype).prod
      (M.chargeVector.comp G.invariantCore.subtype))

/-- The SOURCE closed physical graph at massless h=1,m=0
is the closure of the original 16-charge graph on
the literal original GaugeData invariant smooth core.
No source graph/image/closure is replaced or assumed. -/
theorem original_source_physicalGraph_eq_massless
    {N : ℕ} (M : AlgebraData N) (G : M.GaugeData) :
    G.deformedModelGraph 1 0 =
      (original_source_physicalCoreGraph M G).topologicalClosure := by
  unfold GaugeData.deformedModelGraph
    GaugeData.deformedModelGraphMap
    original_source_physicalCoreGraph
  rw [original_source_chargeVector_eq_massless M]

#print axioms original_source_chargeVector_eq_massless
#print axioms original_source_coreGraph_eq_massless
#print axioms original_source_closedGraph_eq_massless
#print axioms original_source_smoothCore_invariant_iff_gauss
#print axioms original_source_physicalCoreGraph
#print axioms original_source_physicalGraph_eq_massless
#check @original_source_physicalGraph_eq_massless

end
end FCP.BFSSSU2PhysicalDomainL6H5E8AB

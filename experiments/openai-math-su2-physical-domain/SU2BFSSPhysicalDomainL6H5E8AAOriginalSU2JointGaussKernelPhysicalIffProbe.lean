import SU2BFSSPhysicalDomainL6H5E8ZOriginalSU2ColorGeneratedSubgroupTopProbe
import SU2BFSSPhysicalDomainL6G7VActualSourceFullL2PhysicalFixedSpaceProbe

/-!
L6H5E8AA — UNCONDITIONAL original SU(2) source joint maximal
color Gauss generator kernel iff genuine physical Hilbert space.

Strict prerequisite H5E8Z #357:
Each actual original GaugeGroup 2 element is in the algebraic
subgroup generated by the literal original positive-i color curves.
Strict prerequisite H5E8M #330:
The joint kernel of the THREE source maximal color generators is
equivalent to fixedness along that generated subgroup.
Strict prerequisite G7V:
The full genuine source combined bosonic inverse-pullback/fermionic
Fock action is fixed on v for every original GaugeGroup 2 element
iff v is in the ORIGINAL pairedGaugeData.physicalSpace.

No density, closure, differentiability extra hypothesis, new axiom,
different sign, surrogate gauge action, or spectral conclusion.
The maximal color generator domains remain part of the literal goal.
-/

set_option autoImplicit false
set_option maxHeartbeats 450000
set_option synthInstance.maxHeartbeats 170000

namespace FCP.BFSSSU2PhysicalDomainL6H5E8AA
noncomputable section

open OAI.BFSSQuantum
open OAI.BFSSQuantum.AlgebraData
open FCP.BFSSSU2GaugeG4J
open FCP.BFSSSU2PhysicalDomainL6G7U
open FCP.BFSSSU2PhysicalDomainL6G7V
open FCP.BFSSSU2PhysicalDomainL6H5E8E
open FCP.BFSSSU2PhysicalDomainL6H5E8M
open FCP.BFSSSU2PhysicalDomainL6H5E8Z

/-- Every original joint zero of the maximal source color Gauss
generators is fixed by the actual combined FullL2 gauge action
of EVERY element of original SU(2). Source algebraic generation
is already proven, not assumed as a new hypothesis. -/
theorem actualOriginalJointKernel_fixed_fullGauge
    (v : FullL2 2)
    (hker : ∀ c : ColorIndex 2,
      ∃ hdom : v ∈ actualOriginalColorGeneratorDomainSubmodule c,
        actualOriginalColorGeneratorLinear c ⟨v, hdom⟩ = 0)
    (g : GaugeGroup 2) :
    actualOriginalFullL2GaugePairCLM g v = v := by
  exact actualOriginalJointColorGaussKernel_fixed_generated
    v hker g (originalSU2_mem_source_color_generated g)

/-- Full source gauge fixedness is EQUIVALENT to the joint
maximal source color Gauss kernel. This strengthens accepted H5E8M,
which formerly allowed only source generated-subgroup fixedness. -/
theorem actualOriginalJointKernel_iff_fullGaugeFixed (v : FullL2 2) :
    (∀ c : ColorIndex 2,
      ∃ hdom : v ∈ actualOriginalColorGeneratorDomainSubmodule c,
        actualOriginalColorGeneratorLinear c ⟨v, hdom⟩ = 0) ↔
    (∀ g : GaugeGroup 2,
      actualOriginalFullL2GaugePairCLM g v = v) := by
  constructor
  · intro hker g
    exact actualOriginalJointKernel_fixed_fullGauge v hker g
  · intro hfixed
    apply (actualOriginalJointColorGaussKernel_iff_generatedGaugeFixed v).mpr
    intro g _
    exact hfixed g

/-- FINAL unconditional source SU2 color GAUSS-PHYSICAL equivalence:
every actual FullL2 vector v belongs to the original physical Hilbert
subspace iff it is in the maximal generator domain of EVERY original
color direction with generator equal to zero.
No closure/density/regularity hypotheses or mathematical surrogates. -/
theorem actualOriginalJointKernel_iff_physical (v : FullL2 2) :
    (∀ c : ColorIndex 2,
      ∃ hdom : v ∈ actualOriginalColorGeneratorDomainSubmodule c,
        actualOriginalColorGeneratorLinear c ⟨v, hdom⟩ = 0) ↔
      v ∈ pairedGaugeData.physicalSpace := by
  exact (actualOriginalJointKernel_iff_fullGaugeFixed v).trans
    (actualOriginalFullL2GaugePair_fixed_iff_physical v)

#print axioms actualOriginalJointKernel_fixed_fullGauge
#print axioms actualOriginalJointKernel_iff_fullGaugeFixed
#print axioms actualOriginalJointKernel_iff_physical
#check @actualOriginalJointKernel_iff_physical

end
end FCP.BFSSSU2PhysicalDomainL6H5E8AA
